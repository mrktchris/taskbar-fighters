# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs and runtime leftovers (the real runtime state lives in %LOCALAPPDATA%\minis, never here)
*.log
*.pid

# Local overrides and local data
/minis.json
# (V9: art/hand/ is tracked - the hand-polished frames are art source; art/hand_polish.py writes them)
/qa/local/
# art/qa_jump.py strips, GIFs and film strips (~90 MB): regenerate with `python art/qa_jump.py strips|gifs all`
/qa/jump/

# Large preview reels: anything over ~5 MB is regenerated with tools/make_previews.py,
# not committed. (git cannot filter by size; add a path here if a reel grows past that.)

# Editors / OS
.vscode/
.idea/
.claude/
Thumbs.db
.DS_Store

# Packaging output
/build/
/dist/
*.egg-info/
